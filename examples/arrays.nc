a = [11, 12, 13, 14, 15, 16]

# indexing starts at 0
print a[0]

# the last element is #a-1
print a[#a-1]

# negative indexing is supported, -1, is the last element
print a[-1]

# the first element is -#a
print a[-#a]

# third from the end
print a[-3]

# third from the begining
print a[2]

# indexing is periodic
print a[#a + 1]

# indexing is periodic
print a[-#a - 2]
